        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harap cari kode QR yang diberikan melalui email dan arahkan ke dalam bingkai kamera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
