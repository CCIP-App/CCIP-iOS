    "Please keep your ticket as a secret. Do not share it with anyone else but the staff or event booths." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please keep your ticket as a secret. Do not share it with anyone else but the staff or event booths."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harap rahasiakan tiket Anda. Jangan bagikan kepada siapa pun selain staf atau stan acara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チケットは秘密にしておいてください。スタッフやイベントブース以外の人と共有しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "티켓을 안전하게 보관하고, 스태프와 부스 운영자에게만 보여 주세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將您的票保密。除工作人員或活動攤位外，請勿與其他任何人共享。"
          }
        }
      }
    },
    "Please look for the QR code provided by the email and place it in the viewfinder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please look for the QR code provided by the email and place it in the viewfinder"
