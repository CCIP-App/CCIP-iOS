    "Please allow OPass to access your calendar under OPass in your device's settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please allow OPass to access your calendar under OPass in your device's settings."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harap izinkan OPass mengakses kalender Anda melalui pengaturan perangkat, pada bagian OPass."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの設定でOPassがカレンダーにアクセスすることを許可してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 설정의 OPass에서 캘린더 접근을 허용해 주세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
