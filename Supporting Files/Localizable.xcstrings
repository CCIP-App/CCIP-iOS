{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" in room \"%@\", please keep your time of buffer to reach the room." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" in room \"%@\", please keep your time of buffer to reach the room."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" di ruangan \"%@\", mohon sisihkan waktu yang Anda perlukan untuk ke ruangan terebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」が会場「%@」で行われます。時間に余裕をもって会場へお越しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 세션이 %@에서 진행됩니다. 이동 시간을 넉넉히 잡아 주세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在會議室「%@」，請預留足夠的緩衝時間前往。"
          }
        }
      }
    },
